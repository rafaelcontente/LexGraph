ex:art_113_par_8_v_20260727 a lg:VersaoUnidade ;
    lg:estadoVerificacao ai:Candidato ;
    lg:fonteOficial ex:ato_02024R1689-20260727 ;
    lg:texto "8. Regulamento (UE) 2016/424 do Parlamento Europeu e do Conselho, de 9 de março de 2016, relativo às instalações por cabo e que revoga a Diretiva 2000/9/CE (JO L 81 de 31.3.2016, p. 1);" ;
    lg:textoHash "720b4a15596a2ab83fc38bf8e81a80b4304b0aede45acb8d7d79d65091f09e7a" ;
